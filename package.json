{
  "name": "@fishy/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc && tailwindcss -i src/index.css -o dist/styles.css",
    "dev": "concurrently \"tsc -w\" \"tailwindcss -i src/index.css -o dist/styles.css --watch\"",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "concurrently": "10.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "prettier": "3.9.6"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.21.0",
    "next-themes": "0.4.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  }
}
