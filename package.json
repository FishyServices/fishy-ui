{
  "name": "@fishy/ui",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/index.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "build": "tsc && tailwindcss -i src/index.css -o dist/styles.css",
    "dev": "concurrently \"tsc -w\" \"tailwindcss -i src/index.css -o dist/styles.css --watch\"",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/react": "19.3.0",
    "concurrently": "10.0.7",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "~7.0.2"
  },
  "peerDependencies": {
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "next-themes": "0.4.6",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  }
}
